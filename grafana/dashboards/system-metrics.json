{
  "uid": "system-metrics",
  "title": "System Metrics (Windows Host)",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timezone": "",
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Disk free % (per volume)",
      "description": "Headline 'running out of disk' panel.",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 10 },
              { "color": "green", "value": 20 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "showThresholdMarkers": true, "showThresholdLabels": false },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "windows_logical_disk_free_bytes / windows_logical_disk_size_bytes * 100",
          "legendFormat": "{{volume}}",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "CPU usage %",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "showThresholdMarkers": true, "showThresholdLabels": false },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 - (avg(rate(windows_cpu_time_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU busy",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "RAM used %",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "showThresholdMarkers": true, "showThresholdLabels": false },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(1 - windows_memory_available_bytes / windows_memory_physical_total_bytes) * 100",
          "legendFormat": "RAM used",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "gauge",
      "title": "Page file used %",
      "description": "True page-file usage from the pagefile collector (used = limit - free). The page file is Windows' on-disk swap; high sustained usage together with paging activity (bottom-left) is the memory-pressure signal.",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 60 },
              { "color": "red", "value": 85 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "showThresholdMarkers": true, "showThresholdLabels": false },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "(windows_pagefile_limit_bytes - windows_pagefile_free_bytes) / windows_pagefile_limit_bytes * 100",
          "legendFormat": "page file used",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Disk free bytes (trend)",
      "description": "Watch the downward slope.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "decbytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "windows_logical_disk_free_bytes",
          "legendFormat": "{{volume}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU usage % (trend)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 - (avg(rate(windows_cpu_time_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "CPU busy"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "RAM used / total (bytes)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "decbytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "windows_memory_physical_total_bytes",
          "legendFormat": "total"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "windows_memory_physical_total_bytes - windows_memory_available_bytes",
          "legendFormat": "used"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Page file used / limit (bytes)",
      "description": "Page-file space in use versus its configured limit, from the pagefile collector. As 'used' climbs toward 'limit' the on-disk swap is filling; pair with paging activity to judge impact.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "decbytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "windows_pagefile_limit_bytes",
          "legendFormat": "limit"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "windows_pagefile_limit_bytes - windows_pagefile_free_bytes",
          "legendFormat": "used"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Paging activity - hard faults (pages/sec)",
      "description": "Pages moved between RAM and disk each second. Near 0 = healthy. Sustained high 'pages in' WHILE available memory is near zero and the page file is filling means the page file is being thrashed - this is when performance tanks. A brief spike alone (app launch, file copy) is normal.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(windows_memory_swap_pages_read_total[5m])",
          "legendFormat": "pages in (read from disk)"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "rate(windows_memory_swap_pages_written_total[5m])",
          "legendFormat": "pages out (written to disk)"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Available memory (bytes)",
      "description": "RAM available for new allocations without paging. As this approaches zero, further allocations force page-file use. Read it next to 'Paging activity': low available + rising pages-in = real memory pressure.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "decbytes", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "windows_memory_available_bytes",
          "legendFormat": "available"
        }
      ]
    }
  ]
}
